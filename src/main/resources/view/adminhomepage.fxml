<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.AdminHomepageController"
           prefHeight="700.0" prefWidth="1000.0">
   <VBox spacing="16">
      <padding><Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/></padding>

      <HBox alignment="CENTER_LEFT" spacing="10">
         <Button onAction="#logout" text="Log Out"/>
         <Region HBox.hgrow="ALWAYS"/>
      </HBox>

      <VBox spacing="2">
         <Label text="User Administration" styleClass="title-label"/>
         <Label text="Create new users or delete existing ones." styleClass="subtitle-label"/>
      </VBox>

      <StackPane VBox.vgrow="ALWAYS">
         <fx:include fx:id="adminUserList" source="adminuserlist.fxml"/>
      </StackPane>

      <HBox spacing="10" alignment="CENTER">
         <Button fx:id="createUserButton" onAction="#createUser" text="Create New User"
                 styleClass="primary" prefWidth="160"/>
         <Button fx:id="deleteUserButton" onAction="#deleteUser" text="Delete Selected User"
                 disable="true" styleClass="danger" prefWidth="160"/>
      </HBox>
   </VBox>
</StackPane>
