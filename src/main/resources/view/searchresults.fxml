<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.SearchResultsController" prefHeight="700.0" prefWidth="1000.0">
   <padding><Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/></padding>

   <HBox alignment="CENTER_LEFT" spacing="10">
      <Button fx:id="backToHomepageButton" onAction="#backToHomepage" text="← Albums"/>
      <Region HBox.hgrow="ALWAYS"/>
   </HBox>

   <VBox spacing="2">
      <Label text="Search Results" styleClass="title-label"/>
      <Label fx:id="resultsSubtitle" text="" styleClass="subtitle-label"/>
   </VBox>

   <StackPane VBox.vgrow="ALWAYS" styleClass="card">
      <ScrollPane fitToWidth="true">
         <fx:include fx:id="galleryView" source="galleryimageview.fxml"/>
      </ScrollPane>
      <Label fx:id="emptyResultsLabel" text="No photos matched this search."
             styleClass="subtitle-label" visible="false" managed="false"/>
   </StackPane>

   <HBox spacing="10" alignment="CENTER">
      <VBox.margin><Insets top="12.0"/></VBox.margin>
      <Button fx:id="createAlbumButton" onAction="#createAlbum" text="Save Results as Album"
              styleClass="primary" prefWidth="200"/>
   </HBox>
</VBox>
