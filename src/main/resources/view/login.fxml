<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<Pane fx:controller="controller.LoginController"
      maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0"
      prefWidth="800.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <TextField fx:id="usernameTextField" layoutX="300.0" layoutY="300.0" promptText="Username" onAction="#handleLogin"/>
   <Button fx:id="loginButton" layoutX="365.0" layoutY="340.0" mnemonicParsing="false" onAction="#handleLogin" text="Login"/>
   <Text fx:id="loginText" layoutX="250.0" layoutY="200.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Login">
      <font>
         <Font size="95.0"/>
      </font>
   </Text>
</Pane>

