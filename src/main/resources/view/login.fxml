<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.LoginController">
   <VBox alignment="CENTER">
      <Label fx:id="loginTitle" text="Photo Album" styleClass="title-label"/>
      <Label text="Sign in to manage your albums" styleClass="subtitle-label">
         <VBox.margin><Insets top="4.0" bottom="28.0"/></VBox.margin>
      </Label>

      <VBox alignment="CENTER" spacing="14" maxWidth="360.0" styleClass="card">
         <padding><Insets top="32.0" right="32.0" bottom="32.0" left="32.0"/></padding>
         <TextField fx:id="usernameTextField" promptText="Username" onAction="#handleLogin"/>
         <Button fx:id="loginButton" text="Sign In" onAction="#handleLogin" styleClass="primary"
                 maxWidth="Infinity"/>
         <Label text="Tip: try the seeded &quot;stock&quot; account, or &quot;admin&quot; to manage users."
                styleClass="subtitle-label" wrapText="true"/>
      </VBox>
   </VBox>
</StackPane>
